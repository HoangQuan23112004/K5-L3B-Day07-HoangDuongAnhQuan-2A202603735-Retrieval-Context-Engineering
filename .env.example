# Copy to .env. CLI loads it automatically; existing shell variables take precedence.
RAG_PROVIDER=openai
RAG_BASE_URL=https://api.groq.com/openai/v1
RAG_CHAT_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

RAG_EMBEDDING_BACKEND=fastembed
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_VECTOR_STORE=qdrant

# Groq request pacing and bounded retries for HTTP 429.
RAG_REQUEST_INTERVAL_SECONDS=3
RAG_MAX_RETRIES=3
RAG_MAX_RETRY_WAIT_SECONDS=60
